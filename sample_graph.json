      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "OddSum is even",
        "tex": "\\sum_{v \\in V_{odd}} \\text{deg}(v) \\equiv 0 \\pmod 2"
      },
      "animation": {
