{
  "title": "Number of odd-degree vertices is even",
  "technique": "direct",
  "summary": "Using the Handshaking Lemma, we show the sum of all degrees is twice the number of edges. Since even-degree vertices sum to an even number, the remaining sum (from odd-degree vertices) must also be even, forcing an even number of such vertices.",
  "steps": [
    {
      "id": "S1",
      "statement": "∑[v ∈ V] deg(v) = 2|E|",
      "type": "inference",
      "justification": "Handshaking Lemma: every edge has two endpoints, contributing 2 to the total degree sum.",
      "depends_on": [],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "Σ deg(v) = 2|E|",
        "tex": "\\sum_{v \\in V} \\text{deg}(v) = 2|E|"
      },
      "animation": {
        "action": "appear",
        "targets": [
          "v1",
          "v2",
          "v3",
          "v4",
          "v5",
          "v6"
        ],
        "emphasis": "none",
        "duration": "medium",
        "caption": "The sum of all degrees is always twice the number of edges",
        "duration_ms": 800
      }
    },
    {
      "id": "S2",
      "statement": "∑[v ∈ V] deg(v) is even",
      "type": "inference",
      "justification": "Any integer multiplied by 2 is even.",
      "depends_on": [
        "S1"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "Sum is even",
        "tex": "\\text{Sum is even}"
      },
      "animation": {
        "action": "highlight",
        "targets": [
          "v1",
          "v2",
          "v3",
          "v4",
          "v5",
          "v6"
        ],
        "emphasis": "pulse",
        "duration": "short",
        "caption": "Therefore, the total sum must be even",
        "duration_ms": 400
      }
    },
    {
      "id": "S3",
      "statement": "∑[v ∈ V_even] deg(v) + ∑[v ∈ V_odd] deg(v) = even",
      "type": "inference",
      "justification": "Partitioning the set of vertices into those with even degree and those with odd degree.",
      "depends_on": [
        "S2"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "EvenSum + OddSum = Even",
        "tex": "\\sum_{v \\in V_{even}} \\text{deg}(v) + \\sum_{v \\in V_{odd}} \\text{deg}(v) = \\text{even}"
      },
      "animation": {
        "action": "move",
        "targets": [
          "even_group",
          "odd_group"
        ],
        "emphasis": "none",
        "duration": "medium",
        "caption": "Split the sum into even-degree and odd-degree vertices",
        "duration_ms": 800
      }
    },
    {
      "id": "S4",
      "statement": "∑[v ∈ V_even] deg(v) is even",
      "type": "inference",
      "justification": "A sum of even numbers is always even.",
      "depends_on": [
        "S3"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "EvenSum is even",
