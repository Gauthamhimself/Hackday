{
  "title": "Sum of first n integers",
  "technique": "induction",
  "summary": "We prove the formula for the sum of the first n integers by showing it works for n=1 and then showing that if it works for n, it must work for n+1.",
  "steps": [
    {
      "id": "S1",
      "statement": "1 + 2 + ... + n = n(n+1)/2 for n ≥ 1",
      "type": "assumption",
      "justification": "This is the claim to be proved.",
      "depends_on": [],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "Σ i = n(n+1)/2",
        "tex": "\\sum_{i=1}^{n} i = \\frac{n(n+1)}{2}"
      },
      "animation": {
