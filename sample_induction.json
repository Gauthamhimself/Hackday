        "caption": "The claim: the sum of the first n integers",
        "duration_ms": 400
      }
    },
    {
      "id": "S2",
      "statement": "n = 1: 1 = 1(2)/2",
      "type": "case",
      "justification": "Base case verification.",
      "depends_on": [
        "S1"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
