        "targets": [
          "d1"
        ],
        "emphasis": "glow",
        "duration": "short",
        "caption": "Base case: n = 1 works",
        "duration_ms": 400
      }
    },
    {
      "id": "S3",
      "statement": "Assume 1 + ... + n = n(n+1)/2",
      "type": "assumption",
      "justification": "Inductive hypothesis.",
      "depends_on": [
        "S1"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "Sₙ = n(n+1)/2",
        "tex": "S_n = \\frac{n(n+1)}{2}"
      },
      "animation": {
        "action": "highlight",
        "targets": [
          "d1",
          "d2",
          "d3",
          "d4",
          "d5",
          "d6"
        ],
        "emphasis": "pulse",
        "duration": "medium",
        "caption": "Assume the formula holds for n",
        "duration_ms": 800
      }
    },
    {
      "id": "S4",
      "statement": "1 + ... + n + (n+1) = n(n+1)/2 + (n+1)",
      "type": "inference",
      "justification": "Adding the next term (n+1) to both sides of the inductive hypothesis.",
      "depends_on": [
        "S3"
      ],
      "gap": false,
      "gap_explanation": "",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "Sₙ₊₁ = Sₙ + (n+1)",
        "tex": "S_{n+1} = \\frac{n(n+1)}{2} + (n+1)"
      },
      "animation": {
        "action": "transform",
        "targets": [
          "d5"
        ],
        "emphasis": "none",
        "duration": "medium",
        "caption": "Add the (n+1)-th term to the sum",
        "duration_ms": 800
      }
    },
    {
      "id": "S5",
      "statement": "n(n+1)/2 + (n+1) = (n+1)(n+2)/2",
      "type": "inference",
      "justification": "Algebraic simplification: factor out (n+1) to get (n+1)[n/2 + 1] = (n+1)[(n+2)/2].",
      "depends_on": [
        "S4"
      ],
      "gap": true,
      "gap_explanation": "Factor out (n+1): (n+1)(n/2 + 1) = (n+1)(n+2/2) = (n+1)(n+2)/2.",
      "error": false,
      "error_explanation": "",
      "confidence": "high",
      "display": {
        "text": "(n+1)(n+2)/2",
        "tex": "\\frac{(n+1)(n+2)}{2}"
      },
      "animation": {
        "action": "transform",
